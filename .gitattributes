# The NCTX flora PDFs are NOT tracked — they are gitignored, because the flora is
# redistribution-restricted and this repo is public. This rule is kept so that if
# permission is ever obtained, 100 MB of binary goes to LFS and not into history,
# where it could not be removed without a rewrite.
# See docs/data-acquisition/corpus/NOTICE.md.
docs/data-acquisition/corpus/*.pdf filter=lfs diff=lfs merge=lfs -text

# The pdftotext dumps stay in ordinary git: they are the files every extraction
# actually reads, and they need to diff.
docs/data-acquisition/corpus/*.txt text
