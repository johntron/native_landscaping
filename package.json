{
  "name": "native_landscaping",
  "version": "1.0.0",
  "description": "Backyard seasonal visualization",
  "type": "module",
  "scripts": {
    "test": "node tests/run-tests.cjs",
    "serve": "node server.js",
    "setup": "hooks=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")/.githooks\" && test -x \"$hooks/_dispatch\" && git config core.hooksPath \"$hooks\" && echo \"core.hooksPath = $(git config --get core.hooksPath)\"",
    "test:e2e": "playwright test",
    "usda-plants:mcp": "node tools/usda-plants/mcpServer.js",
    "ecosystem:fetch": "node tools/fetch-ecosystem-index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jszip": "^3.10.1",
    "zod": "^4.4.3"
  },
  "keywords": [],
