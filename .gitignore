node_modules/

# Playwright e2e artifacts
test-results/
playwright-report/
layout-history.json
# Backups tools/migrate-species-ids.mjs writes beside each file it changes.
# History is hand-entered and partly someone else's yard: never commit it.
layout-history.json.bak-*
projects/*/planting_layout.csv.bak-*
.env

# Exact addresses/coordinates behind each project's `place` label. This repo
# is public — see the note on docs/data-acquisition/corpus below. Since
# nl-3s5.3 they live in app.db (projects.location_json); any location.json
# still on disk is a pre-import source file, never committed.
projects/*/location.json

# Local backup of every user's saved monitoring areas (nl-3s5.5). Area names
# can identify people and belong to different users, so it never reaches git;
# written under DATA_DIR by tools/savedAreas/savedAreasDb.js.
data/saved-areas.export.json

# Yards are private and live in app.db (nl-3s5.3), their photos under
# DATA_DIR/projects/<id>/img/. The files that used to hold them stay on disk as
# the import's source but are not tracked. Only backyard's non-secret files
# stay tracked, as the seed for the shared read-only example yard (nl-3s5.24).
projects/*
!projects/backyard/
# Photos under DATA_DIR (default data/projects/<id>/img/): hand-entered, not
# rebuildable, and never committed.
data/projects/
# The backup job's health signal (tools/backup/run-backup.mjs, nl-3s5.13),
# and its temp file during the atomic rename.
data/backup-status.json
data/backup-status.json.tmp-*
# The encryption keys of the backup crypt remote (tools/backup/setup-crypt-remote.sh).
# Losing them makes every backup unreadable; leaking them opens every backup.
# The owner keeps an offline copy. Never commit it.
.backup-crypt.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
*.db-shm
*.db-wal
.beads-credential-key
.beads/proxieddb/

# CodeGraph index (derived, machine-local; rebuild with `codegraph init .`)
.codegraph/

# The NCTX flora PDFs. Free to download from BRIT/Austin College, NOT free to
# redistribute — and this repo is public. Keep them local; the extracted *.txt
# beside them is what every measurement reads.
# See docs/data-acquisition/corpus/NOTICE.md.
docs/data-acquisition/corpus/*.pdf
